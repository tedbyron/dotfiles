#!/usr/bin/env python3
#
# Marks Jellyfin episodes played for the Serializd seasons marked watched and
# diary logs. Jellyscribe's Serializd import only reads single-episode diary
# logs. Played is set without a LastPlayedDate, like Jellyscribe's import, so
# its catch-up doesn't log the episodes back to Serializd.
#
# Usage: serializd-import-watched [--dry-run] [serializd-user] [jellyfin-user]

import json, os, sys, urllib.parse, urllib.request

args = [a for a in sys.argv[1:] if a != "--dry-run"]
dry_run = len(args) < len(sys.argv) - 1
serializd_user, jellyfin_user = (args + ["tedtard", "tb"][len(args):])[:2]
token = open(os.path.expanduser("~/.config/jelly-metrics/token")).read().strip()

def fetch(url, method="GET", body=None, headers={}):
    req = urllib.request.Request(
        url,
        method=method,
        data=None if body is None else json.dumps(body).encode(),
        headers={"Accept": "application/json", "Content-Type": "application/json", **headers},
    )
    with urllib.request.urlopen(req, timeout=60) as r:
        data = r.read()
        return json.loads(data) if data else None

def serializd(path, **params):
    query = "?" + urllib.parse.urlencode(params) if params else ""
    return fetch(
        "https://serializd.onrender.com/api" + path + query,
        headers={
            "Origin": "https://www.serializd.com",
            "Referer": "https://www.serializd.com",
            "X-Requested-With": "serializd_vercel",
        },
    )

def jellyfin(path, method="GET", body=None):
    return fetch(
        "http://127.0.0.1:8096" + path,
        method,
        body,
        {"Authorization": f'MediaBrowser Token="{token}"'},
    )

def pages(path, key, **params):
    page = 1
    while True:
        data = serializd(path.format(page=page), **params)
        yield from data.get(key) or []
        if page >= (data.get("totalPages") or 0):
            return
        page += 1

user = next(u for u in jellyfin("/Users") if u["Name"] == jellyfin_user)
series = jellyfin(
    f"/Items?userId={user['Id']}&IncludeItemTypes=Series&Recursive=true&Fields=ProviderIds"
)["Items"]
by_tmdb = {int(s["ProviderIds"]["Tmdb"]): s for s in series if s["ProviderIds"].get("Tmdb")}

# show TMDb ID -> season IDs watched in full, and (season ID, episode) logs
seasons, episodes = {}, set()
watched = pages(
    f"/user/{serializd_user}/watchedpage_v2/{{page}}",
    "items",
    sort_by="date_added_desc",
    filters="{}",
)
for item in watched:
    seasons.setdefault(item["showId"], set()).update(item["seasonIds"])
for log in pages(f"/user/{serializd_user}/diary?page={{page}}", "reviews"):
    if log.get("seasonId") is None:
        continue
    if log.get("episodeNumber"):
        episodes.add((log["showId"], log["seasonId"], log["episodeNumber"]))
    else:
        seasons.setdefault(log["showId"], set()).add(log["seasonId"])

marked = 0
for tmdb in sorted(set(seasons) | {s for s, _, _ in episodes}):
    show = by_tmdb.get(tmdb)
    if not show:
        continue
    numbers = {s["id"]: s["seasonNumber"] for s in serializd(f"/show/{tmdb}")["seasons"]}
    full = {numbers[i] for i in seasons.get(tmdb, ()) if i in numbers}
    single = {(numbers[i], e) for s, i, e in episodes if s == tmdb and i in numbers}
    items = jellyfin(f"/Shows/{show['Id']}/Episodes?userId={user['Id']}")["Items"]
    for ep in items:
        season, first = ep.get("ParentIndexNumber"), ep.get("IndexNumber")
        if season is None or first is None or ep["UserData"]["Played"]:
            continue
        covered = range(first, (ep.get("IndexNumberEnd") or first) + 1)
        if season not in full and not any((season, e) in single for e in covered):
            continue
        print(f"{show['Name']} S{season:02}E{first:02} {ep['Name']}")
        if not dry_run:
            jellyfin(f"/UserItems/{ep['Id']}/UserData?userId={user['Id']}", "POST", {"Played": True})
        marked += 1

verb = "Would mark" if dry_run else "Marked"
print(f"{verb} {marked} episodes played for {jellyfin_user}")
